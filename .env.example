# Скопируй в .env и заполни: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather (/newbot). Без него api не стартует.
# Это файл-шаблон, он лежит в git — реальный токен только в .env.
BOT_TOKEN=

# HTTPS-URL, по которому открывается Mini App.
# Локально — адрес туннеля: cloudflared tunnel --url http://localhost:5173
# На VPS — https://<твой домен>
APP_URL=https://example.trycloudflare.com

# Максимальный возраст initData. Дольше — считаем протухшим и отдаём 401.
TMA_INITDATA_TTL=24h

# Включить long-polling бота (/start с кнопкой Mini App).
# false — api поднимется без бота, удобно пока нет токена.
BOT_POLLING_ENABLED=true

# Чат модерации (§5). Заготовка, на скелете не используется.
MODERATION_CHAT_ID=

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=flatmatch
POSTGRES_PASSWORD=flatmatch
POSTGRES_DB=flatmatch

# Строка подключения api.
# Локально (api на хосте, postgres в docker): host=localhost
# В docker compose: host=postgres — значение переопределяется в compose-файле.
DATABASE_URL=postgres://flatmatch:flatmatch@localhost:5432/flatmatch?sslmode=disable

# --- API --------------------------------------------------------------------
API_ADDR=:8080
LOG_LEVEL=info

# --- Caddy (только для деплоя на VPS) ---------------------------------------
# Домен, на который Caddy выпустит сертификат.
# Локально compose не нужен — оставь localhost.
DOMAIN=localhost
