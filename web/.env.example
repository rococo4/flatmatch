# Скопируй в web/.env.local — он в git не попадает (*.local в web/.gitignore).
# Нужен только для разработки в обычном браузере, вне Telegram.

# Подписанная initData, чтобы api пропустил запросы из браузера.
# Сгенерировать: cd api && go run ./cmd/devinitdata
# Подписывается тем же BOT_TOKEN, что читает api, — иначе будет 401.
VITE_MOCK_INIT_DATA=

# Абсолютный адрес api. Оставь пустым: dev-сервер Vite проксирует /api,
# в проде то же делает Caddy — все запросы same-origin.
VITE_API_BASE_URL=
