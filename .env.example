# Скопируй в .env и заполни: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather (/newbot). Без него api не стартует.
# Это файл-шаблон, он лежит в git — реальный токен только в .env.
BOT_TOKEN=

# HTTPS-URL, по которому открывается Mini App.
# Локально — адрес туннеля: cloudflared tunnel --url http://localhost:5173
# На VPS — https://<твой домен>
APP_URL=https://example.trycloudflare.com

# Максимальный возраст initData. Дольше — считаем протухшим и отдаём 401.
TMA_INITDATA_TTL=24h

# Включить long-polling бота (/start с кнопкой Mini App).
# false — api поднимется без бота, удобно пока нет токена.
BOT_POLLING_ENABLED=true

# Чат модерации (§5): личный чат с ботом или группа; пусто — очереди копятся,
# /queue в чате досылает накопленное.
MODERATION_CHAT_ID=

# Фоновый воркер пушей (§7) и период разбора очереди. Без поллинга бота
# вопросы с кнопками («ещё ищешь?», опрос) не задаются — ответить некуда.
PUSH_WORKER_ENABLED=true
PUSH_TICK=30s

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=flatmatch
POSTGRES_PASSWORD=flatmatch
POSTGRES_DB=flatmatch

# Строка подключения api.
# Локально (api на хосте, postgres в docker): host=localhost
# В docker compose: host=postgres — значение переопределяется в compose-файле.
DATABASE_URL=postgres://flatmatch:flatmatch@localhost:5432/flatmatch?sslmode=disable

# --- API --------------------------------------------------------------------
API_ADDR=:8080
LOG_LEVEL=info

# --- Caddy (только для деплоя на VPS) ---------------------------------------
# Домен, на который Caddy выпустит сертификат.
# Локально compose не нужен — оставь localhost.
DOMAIN=localhost

# --- Парсер каналов (§13, сервис parser, docker compose --profile parser) ---
# Ключ Claude API с console.anthropic.com (подписка Claude в API не
# конвертируется). Без него парсер копит посты неразобранными.
ANTHROPIC_API_KEY=

# Каналы аренды через запятую, без @. Пусто — дефолтный список в parser/config.py.
PARSER_CHANNELS=

# Период опроса лент каналов, минут. Пусто — дефолт парсера (20).
POLL_MINUTES=

# Раз во сколько часов парсер перепроверяет живость t.me-постов под активными
# точками. Пусто — дефолт парсера (4).
ALIVE_HOURS=

# Путь к справочнику станций (api/internal/service/zones/moscow.json), которым
# парсер размечает станцию из поста в зону. Дефолт рассчитан на локальный
# запуск (parser/ и api/ рядом на диске) — в docker compose пока не смонтирован.
ZONES_PATH=
