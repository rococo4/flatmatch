# Caddy is the only thing exposed on the VPS: it terminates TLS, serves the
# built Mini App, and proxies the API. HTTPS is not optional — Telegram refuses
# to open a Mini App over plain HTTP (§10).
#
# DOMAIN comes from .env. On a real domain Caddy obtains a certificate from
# Let's Encrypt automatically; with the default `localhost` it issues a local
# one instead, which is enough to check the container starts.

{$DOMAIN:localhost} {
	encode zstd gzip

	# The API and the health check are one origin with the front-end, so the
	# browser never makes a cross-origin request and CORS stays out of the
	# picture entirely.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	# Photos live on the api's volume and are served by it under /media; without
	# this route they would fall through to the SPA handler below and come back
	# as index.html.
	handle /media/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Vite fingerprints filenames under /assets, so those may be cached
		# indefinitely. index.html must not be, or a deploy would keep serving
		# the previous build's script tags.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# Single-page app: unknown paths are routes, not missing files.
		try_files {path} /index.html
		file_server
	}

	# Deliberately no X-Frame-Options: web Telegram opens a Mini App inside an
	# iframe, and denying framing would show the user a blank box.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
